<Window x:Class="LessonManager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LessonManager.View"
        xmlns:vm="clr-namespace:LessonManager.ViewModel"
        mc:Ignorable="d"
        Title="Менеджер Занятий" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" x:Name="SideBar"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--Кнопка открытия SideBar-->
        <Button Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding OpenSideBarCommand}" 
        CommandParameter="{Binding ElementName=SideBar}">
            <Image Source="/View/OpenSideBarIcon.png"></Image>
        </Button>
        <!--Развернутое положение-->
        <StackPanel Visibility="{Binding Path=SideBarOpenedElementVisibility}" Grid.Column="0" >
            <Rectangle HorizontalAlignment="Left" Height="32" Width="256"/>
            <Rectangle Stroke="Violet" HorizontalAlignment="Left" Height="32" Width="256"/>
        </StackPanel>
        <!--Свернутое положение-->
        <StackPanel Visibility="{Binding Path=SideBarClosedElementVisibility}" Grid.Column="0">
            <Separator Opacity="0" Height="28"/>
            <Separator Opacity="0" Height="2"/>
            <!--Кнопка добавления учебной дисциплины-->
            <Button Width="32" Height="32" HorizontalAlignment="Left">
                <Image Source="/View/AddSubject.png"></Image>
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Separator Opacity="0" Height="2"/>
            <!--Кнопка добавления учебного занятия-->
            <Button Width="32" Height="32" HorizontalAlignment="Left">
                <Image Source="/View/AddActivity.png"></Image>
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
        
        <GridSplitter IsEnabled="False" Grid.Column="1" ShowsPreview="False" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

        <!--Рабочая область-->
        <StackPanel Grid.Column="2">
            
        </StackPanel>
    </Grid>
</Window>
