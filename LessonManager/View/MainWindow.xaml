<Window x:Class="LessonManager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LessonManager.View"
        xmlns:localconv="clr-namespace:LessonManager.View.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:LessonManager.ViewModel"
        xmlns:m="clr-namespace:LessonManager.Model"
        mc:Ignorable="d"
        Title="Менеджер Занятий" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <ObjectDataProvider x:Key="ActivityStateTypeSR" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type Type="m:ActivityStateType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <localconv:ActivityStateToColorConverter x:Key="ActivityStateToColorConverter"/>
        <localconv:DaysToDeadLineConverter x:Key="DaysToDeadLineConverter"/>
        <localconv:DaysToDeadLineColorConverter x:Key="DaysToDeadLineColorConverter"/>
        <!--СТИЛИ-->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding State, Converter={StaticResource ActivityStateToColorConverter}}"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                            </Trigger>

                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="TextBlock.Foreground" Value="{Binding ActivityTime,Converter={StaticResource DaysToDeadLineColorConverter}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!--Красивые GridSplitter-ы-->
        <ControlTemplate x:Key="GS">
            <Grid>
                <Button Content="⁞" />
                <Rectangle Fill="LightGray" />
            </Grid>
        </ControlTemplate>
        <Style TargetType="GridSplitter">
            <Setter Property="Template" Value="{StaticResource GS}"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ShowsPreview" Value="False"/>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" MinWidth="64"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" MinWidth="256"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Grid.Row="1"/>

        <Menu Grid.Row="0" Grid.ColumnSpan="3" Height="16">
            <MenuItem Header="Основа">
                <MenuItem Header="Добавить дисциплину" Command="{Binding AddSubjectCommand}"/>
                <MenuItem Header="Импортировать ISC" Command="{Binding OpenISCFileCommand}"/>
                <MenuItem Header="Удалить информацию о занятиях" Command="{Binding ReloadDBCommand}"/>
                <Separator />
                <MenuItem Header="Настройки"/>
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="Выйти" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem x:Name="InfoMenuItem" Header="Справка" Click="InfoMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!--Список дисциплин-->
        <TreeView Grid.Column="0" Grid.Row="1" x:Name="ActivitiesTreeView" BorderThickness="0"/>

        <!--Рабочая область-->
        <ScrollViewer Grid.Column="2" Grid.Row="1">

            <StackPanel>
                <DataGrid
                    x:Name="ActivitiesDataGrid"
                    ItemsSource="{Binding CurrentActivities}"
                    AutoGenerateColumns="False"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    CanUserAddRows="True"
                    CanUserDeleteRows="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn 
                            Header="Название" 
                            Binding="{Binding Name}"
                            Width="4*"/>

                        <DataGridTemplateColumn
                            Header="Дата"
                            Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActivityTime, StringFormat=\{0:dd.MM.yy HH:mm\}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ActivityTime}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridComboBoxColumn 
                            Header="Состояние"
                            ItemsSource="{Binding Source={StaticResource ActivityStateTypeSR}}"
                            SelectedValueBinding="{Binding State}"
                            Width="1*"/>

                        <DataGridTextColumn
                            Header="ДдД"
                            Width="0.5*" 
                            Binding="{Binding ActivityTime,Converter={StaticResource DaysToDeadLineConverter}}"
                            IsReadOnly="True"/>

                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
