<Window x:Class="LessonManager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LessonManager.View"
        xmlns:vm="clr-namespace:LessonManager.ViewModel"
        mc:Ignorable="d"
        Title="Менеджер Занятий" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Menu">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!--Красивые GridSplitter-ы-->
        <ControlTemplate x:Key="GS">
            <Grid>
                <Button Content="⁞" />
                <Rectangle Fill="LightGray" />
            </Grid>
        </ControlTemplate>
        <Style TargetType="GridSplitter">
            <Setter Property="Template" Value="{StaticResource GS}"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ShowsPreview" Value="False"/>
        </Style>
    </Window.Resources>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0.5*" MinWidth="64"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MinWidth="256"/>
        </Grid.ColumnDefinitions>
        <GridSplitter IsEnabled="False" Grid.Column="1" Grid.Row="1"/>
        <GridSplitter Grid.Column="3" Grid.Row="1"/>

        <Menu Grid.Row="0" Grid.ColumnSpan="5" Height="16">
            <MenuItem Header="Основа">
                <Separator />
                <MenuItem Header="Настройки"/>
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="Выйти" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem x:Name="InfoMenuItem" Header="Справка" Click="InfoMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!--Кнопка добавления учебной дисциплины-->
        <Button ToolTip="Добавить дисциплину" Grid.Column="0" Grid.Row="1" x:Name="AddSubjectButton" Width="32" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Click="AddSubjectButton_Click">
            <Image Source="../Content/AddSubject.png"/>
        </Button>

        <!--Список дисциплин-->
        <TreeView Grid.Column="2" Grid.Row="1" x:Name="SubjectsAndLabTreeView" BorderThickness="0"/>
        
        <!--Рабочая область-->
        <ScrollViewer Grid.Column="4" Grid.Row="1">
            <StackPanel x:Name="WorkFieldStackPanel">

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
